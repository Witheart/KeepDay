<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 外圈：暗示"循环坚持"，用低透明度避免抢主体 -->
    <path
        android:pathData="M26,54 a28,28 0 1,0 56,0 a28,28 0 1,0 -56,0"
        android:strokeColor="#4DFFFFFF"
        android:strokeWidth="2.5" />

    <!-- 勾选：白→暖金渐变，对应应用里的进度高亮色 -->
    <path
        android:pathData="M40,55.5 L50,65.5 L69.5,42.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="8.5">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:endX="69.5"
                android:endY="42.5"
                android:startX="40"
                android:startY="65.5"
                android:type="linear">
                <item
                    android:color="#FFFFFFFF"
                    android:offset="0.0" />
                <item
                    android:color="#FFFFE3B0"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
